          "name": "Returns images from E-Pics.",
          "request": {
            "name": "Returns images from E-Pics.",
            "description": {
              "content": "Returns images from E-Pics.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "epics-items"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "q",
                  "value": "<string>",
                  "description": "Returns the images for the search term (q).\n\nExample: q=uetliberg"
                },
                {
                  "disabled": false,
                  "key": "lat",
                  "value": "<number>",
                  "description": "Returns the photos from the “Image Archive Online” catalog whose camera location is near a defined point. Or the point is defined for a provenance in the catalog “Ex meis libris”. The point is defined by lat (latitude) and long (longitude) and optionally dist (radius) in meters (default: 1000).\n\nExample: lat=47.349952"
                },
                {
                  "disabled": false,
                  "key": "lon",
                  "value": "<number>",
                  "description": "Returns the photos from the “Image Archive Online” catalog whose camera location is near a defined point. Or the point is defined for a provenance in the catalog “Ex meis libris”. The point is defined by lat (latitude) and long (longitude) and optionally dist (radius) in meters (default: 1000)."
                },
                {
                  "disabled": false,
                  "key": "dist",
                  "value": "<number>",
                  "description": "Returns the photos from the “Image Archive Online” catalog whose camera location is near a defined point. Or the point is defined for a provenance in the catalog “Ex meis libris”. The point is defined by lat (latitude) and long (longitude) and optionally dist (radius) in meters (default: 1000).\n\nExample: dist=1000"
                },
                {
                  "disabled": false,
                  "key": "edges",
                  "value": "<boolean>",
                  "description": "Should the edges/relations to contributors also be returned (default: true)?\n\nExample: edges=false"
                }
              ],

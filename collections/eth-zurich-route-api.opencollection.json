{
  "opencollection": "1.0.0",
  "info": {
    "name": "Discovery bitstreams Route API",
    "version": "1.0.2"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "apikey",
      "value": "{{apikey}}",
      "placement": "query"
    }
  },
  "items": [
    {
      "info": {
        "name": "Route",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get route by id",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.library.ethz.ch/discovery/v1/routes/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Get route by id"
        },
        {
          "info": {
            "name": "Get excerpt of all routes",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.library.ethz.ch/discovery/v1/routes",
            "params": [
              {
                "name": "pageSize",
                "value": "",
                "type": "query"
              },
              {
                "name": "pageNr",
                "value": "",
                "type": "query"
              },
              {
                "name": "search",
                "value": "",
                "type": "query"
              },
              {
                "name": "sort",
                "value": "",
                "type": "query"
              },
              {
                "name": "details",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Get excerpt of all routes"
        }
      ]
    }
  ],
  "bundled": true
}
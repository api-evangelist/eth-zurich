      "item": [
        {
          "id": "a1924d33-b749-4821-959d-2e4b21767432",
          "name": "Returns locations: pois (from ETHorama), places (Marc 651 from e-rara and e-maps) and publication places.",
          "request": {
            "name": "Returns locations: pois (from ETHorama), places (Marc 651 from e-rara and e-maps) and publication places.",
            "description": {
              "content": "Returns locations: pois (from ETHorama), places (Marc 651 from e-rara and e-maps) and publication places.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "locations"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "lat",
                  "value": "<number>",
                  "description": "Returns the pois or places (subject added entry-geographic names from marc 651) that are near a point defined by lat (latitude) and lon (longitude) and optionally dist (distance) in metres (default: 1000).\n\nExample: lat=47.349952"
                },
                {
                  "disabled": false,
                  "key": "lon",
                  "value": "<number>",
                  "description": "Returns the pois or places (subject added entry-geographic names from marc 651) that are near a point defined by lat (latitude) and lon (longitude) and optionally dist (distance) in metres (default: 1000).\n\nExample: lon=8.490838"
                },
                {
                  "disabled": false,
                  "key": "dist",
                  "value": "<number>",
                  "description": "Returns the pois or places (subject added entry-geographic names from marc 651) that are near a point defined by lat (latitude) and lon (longitude) and optionally dist (distance) in metres (default: 1000).\n\nExample: dist=1000"
                },
                {
                  "disabled": false,
                  "key": "q",
                  "value": "<string>",
                  "description": "Returns the data for the search term (q).The parameter \"q\" is alternative to \"lat\"/\"lon\".\n\nExample: q=kyburg"
                },
                {
                  "disabled": false,
                  "key": "edges",
                  "value": "<boolean>",
                  "description": "Should the edges/relations to e-rara, e-maps etc. also be returned (default: true)?\n\nExample: edges=false"
                }
              ],
              "variable": []
            },

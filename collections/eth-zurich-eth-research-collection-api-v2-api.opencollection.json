{
  "opencollection": "1.0.0",
  "info": {
    "name": "Discovery bitstreams ETH Research Collection API V2 API",
    "version": "1.0.2"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "apikey",
      "value": "{{apikey}}",
      "placement": "query"
    }
  },
  "items": [
    {
      "info": {
        "name": "ETH Research Collection API V2",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Retrieve API root information",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.library.ethz.ch/discovery/v1/"
          },
          "docs": "Returns general information about the DSpace instance and available API endpoints."
        }
      ]
    }
  ],
  "bundled": true
}
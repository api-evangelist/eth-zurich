{
  "opencollection": "1.0.0",
  "info": {
    "name": "Discovery bitstreams e-rara API",
    "version": "1.0.2"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "apikey",
      "value": "{{apikey}}",
      "placement": "query"
    }
  },
  "items": [
    {
      "info": {
        "name": "e-rara",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "GET /e-rara-maps",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.library.ethz.ch/discovery/v1/e-rara-maps",
            "params": [
              {
                "name": "lat",
                "value": "",
                "type": "query",
                "description": "Returns maps in which the point defined by lat (latitude) and lon (longitude) is located.\n\nExample: lat=47.349952"
              },
              {
                "name": "lon",
                "value": "",
                "type": "query",
                "description": "Returns maps in which the point defined by lat (latitude) and lon (longitude) is located.\n\nExample: lon=8.490838"
              },
              {
                "name": "q",
                "value": "",
                "type": "query",
                "description": "Returns maps for the search term (q).The parameter \"q\" is alternative to \"lat\"/\"lon\".\n\nExample: q=kyburg"
              }
            ]
          },
          "docs": "Returns maps from e-rara (ETH)."
        },
        {
          "info": {
            "name": "GET /e-rara-maps/{id}",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.library.ethz.ch/discovery/v1/e-rara-maps/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "MMS ID"
              },
              {
                "name": "edges",
                "value": "",
                "type": "query",
                "description": "Should the edges/relations to topics, poi-items, contributors etc. also be returned (default: true)?\n\nExample: edges=false"
              }
            ]
          },
          "docs": "Returns an e-rara map and related resources."
        }
      ]
    }
  ],
  "bundled": true
}
{
  "opencollection": "1.0.0",
  "info": {
    "name": "Discovery bitstreams Geo Container API",
    "version": "1.0.2"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "apikey",
      "value": "{{apikey}}",
      "placement": "query"
    }
  },
  "items": [
    {
      "info": {
        "name": "Geo Container",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "GET /geo-container",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.library.ethz.ch/discovery/v1/geo-container",
            "params": [
              {
                "name": "q",
                "value": "",
                "type": "query",
                "description": "The string for which similar entities are searched\n\nq=Gewässerkorrekturen"
              }
            ]
          },
          "docs": "Provides similar POIs, dossiers, historical journeys from ETHorama and places from the catalog"
        }
      ]
    }
  ],
  "bundled": true
}
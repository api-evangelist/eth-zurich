{
  "opencollection": "1.0.0",
  "info": {
    "name": "Discovery bitstreams Contributors API",
    "version": "1.0.2"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "apikey",
      "value": "{{apikey}}",
      "placement": "query"
    }
  },
  "items": [
    {
      "info": {
        "name": "Contributors",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "GET /contributors",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.library.ethz.ch/discovery/v1/contributors",
            "params": [
              {
                "name": "q",
                "value": "",
                "type": "query",
                "description": "Returns contributors and related resources for the search term (q).\n\nExample: q=Heim, Albert"
              },
              {
                "name": "edges",
                "value": "",
                "type": "query",
                "description": "Should the edges/relations to e-maps and e-rara-items also be returned (default: true)?\n\nExample: edges=false"
              }
            ]
          },
          "docs": "Returns contributors (from e-rara and e-maps) and related resources."
        }
      ]
    }
  ],
  "bundled": true
}
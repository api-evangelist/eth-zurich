{
  "opencollection": "1.0.0",
  "info": {
    "name": "Discovery bitstreams Dossiers API",
    "version": "1.0.2"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "apikey",
      "value": "{{apikey}}",
      "placement": "query"
    }
  },
  "items": [
    {
      "info": {
        "name": "Dossiers",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "GET /dossiers",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.library.ethz.ch/discovery/v1/dossiers",
            "params": [
              {
                "name": "q",
                "value": "",
                "type": "query",
                "description": "Returns dossiers for the search term (q).\n\nExample: q=bahnen"
              },
              {
                "name": "edges",
                "value": "",
                "type": "query",
                "description": "Should the edges/relations to pois, poi-items and e-rara-items also be returned (default: true)?\n\nExample: edges=false"
              }
            ]
          },
          "docs": "Returns the dossiers and related resources defined in the ETHorama database."
        },
        {
          "info": {
            "name": "GET /dossiers/{id}",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.library.ethz.ch/discovery/v1/dossiers/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "dossier ID"
              },
              {
                "name": "edges",
                "value": "",
                "type": "query",
                "description": "Should the edges/relations to pois, poi-items and e-rara-items also be returned (default: true)?\n\nExample: edges=false"
              }
            ]
          },
          "docs": "Returns a dossier and related resources defined in the ETHorama database."
        }
      ]
    }
  ],
  "bundled": true
}
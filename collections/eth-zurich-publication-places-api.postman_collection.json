          "id": "cfbfb347-5dca-4726-bbec-43bb212ceef7",
          "name": "Returns publication places",
          "request": {
            "name": "Returns publication places",
            "description": {
              "content": "Returns publication places",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "pub-places"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "lat",
                  "value": "<number>",
                  "description": "Returns the publication places (marc 751 or marc 264) that are near a point defined by lat (latitude) and lon (longitude) and optionally dist (distance) in metres (default: 1000).\n\nExample: lat=47.349952"
                },
                {
                  "disabled": false,
                  "key": "lon",
                  "value": "<number>",
                  "description": "Returns the publication places (marc 751 or marc 264) that are near a point defined by lat (latitude) and lon (longitude) and optionally dist (distance) in metres (default: 1000).\n\nExample: lon=8.490838"
                },
                {
                  "disabled": false,
                  "key": "dist",
                  "value": "<number>",
                  "description": "Returns the publication places (marc 751 or marc 264) that are near a point defined by lat (latitude) and lon (longitude) and optionally dist (distance) in metres (default: 1000).\n\nExample: dist=1000"
                },
                {
                  "disabled": false,
                  "key": "q",
                  "value": "<string>",
                  "description": "Returns publication places (marc 751 or marc 264) for the search term (q).The parameter \"q\" is alternative to \"lat\"/\"lon\".\n\nExample: q=kyburg"
                },
                {
                  "disabled": false,
                  "key": "edges",
                  "value": "<boolean>",
                  "description": "Should the edges/relations to e-rara, e-maps also be returned (default: true)?\n\nExample: edges=false"
                }
              ],
              "variable": []
            },

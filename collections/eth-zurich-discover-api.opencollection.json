            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.library.ethz.ch/discovery/v1/discover/facets"
          },
          "docs": "Returns a list of available facets for filtering search results."
        },
        {
          "info": {
            "name": "Retrieve author facets",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.library.ethz.ch/discovery/v1/discover/facets/author",
            "params": [
              {
                "name": "query",
                "value": "",
                "type": "query",
                "description": "Search term for author facets."
              },
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "Page number for pagination."
              },
              {
                "name": "size",
                "value": "",
                "type": "query",
                "description": "Number of facet values to return per page."
              }
            ]
          },
          "docs": "Returns author facets based on the query parameter."

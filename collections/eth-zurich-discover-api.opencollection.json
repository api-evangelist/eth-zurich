{
  "opencollection": "1.0.0",
  "info": {
    "name": "Discovery bitstreams Discover API",
    "version": "1.0.2"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "apikey",
      "value": "{{apikey}}",
      "placement": "query"
    }
  },

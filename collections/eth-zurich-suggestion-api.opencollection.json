{
  "opencollection": "1.0.0",
  "info": {
    "name": "Discovery bitstreams Suggestion API",
    "version": "1.0.2"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "apikey",
      "value": "{{apikey}}",
      "placement": "query"
    }
  },
  "items": [
    {
      "info": {
        "name": "Suggestion",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Retrieve query suggestions",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.library.ethz.ch/discovery/v1/suggestion/querySuggestions/search/byQuery",
            "params": [
              {
                "name": "query",
                "value": "",
                "type": "query",
                "description": "Search term for query suggestions."
              },
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "Page number for pagination."
              },
              {
                "name": "size",
                "value": "",
                "type": "query",
                "description": "Number of suggestions to return per page."
              }
            ]
          },
          "docs": "Returns query suggestions based on user input."
        }
      ]
    }
  ],
  "bundled": true
}
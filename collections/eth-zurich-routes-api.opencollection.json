{
  "opencollection": "1.0.0",
  "info": {
    "name": "Discovery bitstreams Routes API",
    "version": "1.0.2"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "apikey",
      "value": "{{apikey}}",
      "placement": "query"
    }
  },
  "items": [
    {
      "info": {
        "name": "Routes",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "GET /routes",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.library.ethz.ch/discovery/v1/routes",
            "params": [
              {
                "name": "q",
                "value": "",
                "type": "query",
                "description": "Returns routes for the search term \"q\".\n\nExample: q=berg"
              },
              {
                "name": "edges",
                "value": "",
                "type": "query",
                "description": "Should the edges/relations to pois, poi-items and e-rara-items also be returned (default: true)?\n\nExample: edges=false"
              }
            ]
          },
          "docs": "Returns routes and related resources defined in the ETHorama database."
        },
        {
          "info": {
            "name": "GET /routes/{id}",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.library.ethz.ch/discovery/v1/routes/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "route ID"
              },
              {
                "name": "edges",
                "value": "",
                "type": "query",
                "description": "Should the edges/relations to pois, poi-items and e-rara-items also be returned (default: true)?\n\nExample: edges=false"
              }
            ]
          },
          "docs": "Returns a route and related resources defined in the ETHorama database."
        }
      ]
    }
  ],
  "bundled": true
}